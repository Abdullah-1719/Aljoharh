```Aljoharh/.env.example# Database Configuration
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Example for local development:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/istiraha_booking?schema=public"
#
# Example for production (e.g., Vercel Postgres, Supabase, Railway, etc.):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public&sslmode=require"

DATABASE_URL="postgresql://postgres:password@localhost:5432/istiraha_booking?schema=public"

# Optional: Node environment (development, production, test)
# NODE_ENV="development"
